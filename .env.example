# ==========================================
# Hello-Agents 环境变量示例模板
# 注意: 请勿将含有真实 Key 的 .env 提交到公开仓库!
# 使用方法: 复制本文件为 .env，并填入你自己的密钥
# ==========================================

# 1. 搜索引擎 API
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# 2. 大语言模型 API (以 ModelScope 为例)
OPENAI_API_KEY=your_modelscope_sdk_token_here
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1/
MODEL_NAME=Qwen/Qwen3.5-27B

# 3. 兼容后续章节变量名
LLM_API_KEY=your_modelscope_sdk_token_here
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/
LLM_MODEL_ID=Qwen/Qwen3.5-27B
